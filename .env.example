# Bible Research API Base URL
VITE_API_BASE_URL=https://bible-research-489314.ey.r.appspot.com

# Sentry error monitoring. The DSN is a public ingestion key —
# safe to ship in the JS bundle. Leave empty/unset to disable
# Sentry entirely (no errors, replays, or traces are sent);
# dev and tests stay silent unless opted in. Real values are
# set per-environment in the Vercel dashboard.
VITE_SENTRY_DSN=

# Sentry sourcemap-upload credentials are CI/Vercel build-time
# env vars only — SENTRY_AUTH_TOKEN, SENTRY_ORG
# (bible-research), SENTRY_PROJECT (reactive-bible-web). They
# are secrets and must NEVER be VITE_-prefixed; the Vite plugin
# activates only when all three are present.

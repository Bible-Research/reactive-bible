{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "**": false
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination":
        "https://bible-research-489314.ey.r.appspot.com/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination":
        "https://bible-research-489314.ey.r.appspot.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
